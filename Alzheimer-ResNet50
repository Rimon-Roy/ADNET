_model.add(Dense(512, activation='relu'))\nadditional_model.add(BatchNormalization())\nadditional_model.add(Dropout(0.5))\nadditional_model.add(Dense(4, activation='softmax'))\n\n# Create an input tensor for the ResNet50 base\nresnet_input = Input(shape=(150, 150, 3))\n\n# Connect the ResNet50 base\nresnet_output = conv_base(resnet_input)\n\n# Flatten the ResNet50 output\nresnet_output_flatten = Flatten()(resnet_output)\n\n# Connect the ResNet50 output with the output of the additional layers\ncombined_output = concatenate([resnet_output_flatten, additional_model(resnet_input)])\n\n# Final output layer\noutput = Dense(4, activation='softmax')(combined_output)\n\n# Create the combined model\ncombined_model = Model(inputs=resnet_input, outputs=output)\n\n# Compile the model\noptimizer = tf.keras.optimizers.Adam(lr=0.001, beta_1=0.9, beta_2=0.999, epsilon=0.1)\ncombined_model.compile(loss='categorical_crossentropy', optimizer=optimizer, metrics=['accuracy'])\n\n# Define the directory to save the model weights\nsave_dir = '/kaggle/working/'\nmodel_name = 'alzheimers_combined_model.h5'\nmodel_path = os.path.join(save_dir, model_name)\n\nreduce_lr = ReduceLROnPlateau(monitor='val_accuracy', factor=0.8, patience=10)\ntensorboard = TensorBoard(log_dir='logs')\ncheckpoint = ModelCheckpoint(model_path, monitor='val_accuracy', save_best_only=True, mode='auto', verbose=1)\n\n# Assuming X_train is your ResNet50 input data\n# Replace X_train with your actual data\nhistory = combined_model.fit(X_train, y_train, epochs=150, batch_size=32, validation_split=0.2, callbacks=[reduce_lr, tensorboard, checkpoint])\n","metadata":{"execution":{"iopub.status.busy":"2025-10-12T16:04:09.244724Z","iopub.execute_input":"2025-10-12T16:04:09.245031Z","iopub.status.idle":"2025-10-12T16:19:53.481273Z","shell.execute_reply.started":"2025-10-12T16:04:09.245007Z","shell.execute_reply":"2025-10-12T16:19:53.480313Z"},"trusted":true},"outputs":[{"name":"stdout","text":"Downloading data from https://storag